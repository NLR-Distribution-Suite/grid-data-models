type":"code","lang":"python","executable":true,"value":"from gdm.distribution.enums import LimitType, Phase, VoltageTypes\nfrom gdm.distribution.components import DistributionSubstation\nfrom gdm.distribution.common.limitset import VoltageLimitSet\nfrom gdm.distribution.components import DistributionFeeder\nfrom gdm.distribution.components import DistributionBus\nfrom gdm.quantities import Voltage\nfrom infrasys import Location\n\nrated_voltage = Voltage(400, \"ampere\")","key":"VyNwdTV2Wd"},{"type":"outputs","id":"iPwtEu9CmwWvm-dH-4IFc","children":[],"key":"V8h4hrjFEs"}],"key":"Nkp77eG1yH"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"try:\n    bus = DistributionBus(\n        voltage_type=VoltageTypes.LINE_TO_LINE,\n        phases=[Phase.A, Phase.B, Phase.C],\n        rated_voltage=rated_voltage,\n        name=\"DistBus1\",\n        substation=DistributionSubstation.example(),\n        feeder=DistributionFeeder.example(),\n        voltagelimits=[\n            VoltageLimitSet(limit_type=LimitType.MIN, value=Voltage(400 * 0.9, \"volt\")),\n            VoltageLimitSet(limit_type=LimitType.MAX, value=Voltage(400 * 1.1, \"volt\")),\n        ],\n        coordinate=Location(x=20.0, y=30.0),\n    )\nexcept Exception as e:\n    print(e)","key":"pRooR6GULS"},{"type":"outputs","id":"5fOCbqWxiKTeozl4MkUl1","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"1 validation error for DistributionBus\nrated_voltage\n  Assertion failed, Unit must be compatible with volt [type=assertion_error, input_value=<Quantity(400, 'ampere')>, input_type=Voltage]\n    For further information visit https://errors.pydantic.dev/2.10/v/assertion_error\n"},"children":[],"key":"wYkHpjUEmK"}],"key":"Q9XImGE3BA"}],"key":"sDi2biQPhD"}],"key":"PPnloldSQT"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"On GDM Data Models","url":"/gdm-intro/data-models","group":"Tut