{"type":"code","lang":"python","executable":true,"value":"from gdm.systems.distribution.enums import LimitType, Phase, VoltageTypes\nfrom gdm.systems.distribution.components import DistributionSubstation\nfrom gdm.systems.distribution.common.limitset import VoltageLimitSet\nfrom gdm.systems.distribution.components import DistributionFeeder\nfrom gdm.systems.distribution.components import DistributionBus\nfrom gdm.quantities import Voltage\nfrom infrasys import Location\n\nrated_voltage = Voltage(400, \"ampere\")","key":"YHPOY6mBlX"},{"type":"outputs","id":"CR93E4KZqaUfNQdswSaPY","children":[],"key":"Lio06vqI0b"}],"key":"qV4vPQ5Kd1"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"try:\n    bus = DistributionBus(\n        voltage_type=VoltageTypes.LINE_TO_LINE,\n        phases=[Phase.A, Phase.B, Phase.C],\n        rated_voltage=rated_voltage,\n        name=\"DistBus1\",\n        substation=DistributionSubstation.example(),\n        feeder=DistributionFeeder.example(),\n        voltagelimits=[\n            VoltageLimitSet(limit_type=LimitType.MIN, value=Voltage(400 * 0.9, \"volt\")),\n            VoltageLimitSet(limit_type=LimitType.MAX, value=Voltage(400 * 1.1, \"volt\")),\n        ],\n        coordinate=Location(x=20.0, y=30.0),\n    )\nexcept Exception as e:\n    print(e)","key":"c4wtWf9sPQ"},{"type":"outputs","id":"jPx24aZQwR07AmIfdbh_9","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"1 validation error for DistributionBus\nrated_voltage\n  Assertion failed, Unit must be compatible with volt [type=assertion_error, input_value=<Quantity(400, 'ampere')>, input_type=Voltage]\n    For further information visit https://errors.pydantic.dev/2.10/v/assertion_error\n"},"children":[],"key":"TMybX5gnJV"}],"key":"nvRQZFz2UC"}],"key":"BOVFyiO4hz"}],"key":"F5bn0a7zu2"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"On GDM Data Models","