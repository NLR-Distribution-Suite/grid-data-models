type":"code","lang":"python","executable":true,"value":"from gdm.systems.distribution.enums import LimitType, Phase, VoltageTypes\nfrom gdm.systems.distribution.components import DistributionSubstation\nfrom gdm.systems.distribution.common.limitset import VoltageLimitSet\nfrom gdm.systems.distribution.components import DistributionFeeder\nfrom gdm.systems.distribution.components import DistributionBus\nfrom gdm.quantities import Voltage\nfrom infrasys import Location\n\nrated_voltage = Voltage(400, \"ampere\")","key":"lL61zKoKjf"},{"type":"outputs","id":"1ZTk_M9xkAM82SDt6iWaZ","children":[],"key":"ElBZBJwQPU"}],"key":"nwkTSg7gYh"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"try:\n    bus = DistributionBus(\n        voltage_type=VoltageTypes.LINE_TO_LINE,\n        phases=[Phase.A, Phase.B, Phase.C],\n        rated_voltage=rated_voltage,\n        name=\"DistBus1\",\n        substation=DistributionSubstation.example(),\n        feeder=DistributionFeeder.example(),\n        voltagelimits=[\n            VoltageLimitSet(limit_type=LimitType.MIN, value=Voltage(400 * 0.9, \"volt\")),\n            VoltageLimitSet(limit_type=LimitType.MAX, value=Voltage(400 * 1.1, \"volt\")),\n        ],\n        coordinate=Location(x=20.0, y=30.0),\n    )\nexcept Exception as e:\n    print(e)","key":"ySS2Rf9ShO"},{"type":"outputs","id":"XF5POzfgggbs9go_Jl01d","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"1 validation error for DistributionBus\nrated_voltage\n  Assertion failed, Unit must be compatible with volt [type=assertion_error, input_value=<Quantity(400, 'ampere')>, input_type=Voltage]\n    For further information visit https://errors.pydantic.dev/2.10/v/assertion_error\n"},"children":[],"key":"M5pPQD2Yt1"}],"key":"Jgs2dtM0FV"}],"key":"a79Zq6VDUF"}],"key":"NxxngVtYc9"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"On GDM Data Models","ur