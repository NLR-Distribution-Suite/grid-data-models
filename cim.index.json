{"version":3,"kind":"Article","sha256":"97f8328aae85747d8448dffcc61fd94d8fc5acb2350cb031a6c021887ac05458","slug":"cim.index","location":"/cim/index.md","dependencies":[],"frontmatter":{"title":"CIM vs GDM a comparison","content_includes_title":false,"authors":[{"nameParsed":{"literal":"Aadil Latif","given":"Aadil","family":"Latif"},"name":"Aadil Latif","id":"contributors-myst-generated-uid-0"}],"github":"https://github.com/NLR-Distribution-Suite/grid-data-models","numbering":{"title":{"offset":1}},"source_url":"https://github.com/NLR-Distribution-Suite/grid-data-models/blob/main/docs/cim/index.md","edit_url":"https://github.com/NLR-Distribution-Suite/grid-data-models/edit/main/docs/cim/index.md","exports":[{"format":"md","filename":"index.md","url":"/grid-data-models/build/index-96106904f1aeb8d05d7afcebcdddf0cf.md"}]},"mdast":{"type":"root","children":[{"type":"block","children":[{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"The common information model (CIM) as defined by the International Electrotechnical Commission (IEC) as “An abstract model that represents all the major objects in an electric utility enterprise typically involved in utility operations”. It provides a standard way of defining object classes, their attributes and relationships. The CIM is currently maintained as UML model.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"RMBGbwqsxQ"}],"key":"VbGX97nr2r"},{"type":"heading","depth":2,"position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"children":[{"type":"text","value":"Need for Language Specific Data Models","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"kTmWpXUhoa"}],"identifier":"need-for-language-specific-data-models","label":"Need for Language Specific Data Models","html_id":"need-for-language-specific-data-models","implicit":true,"key":"BIJ24hsVPT"},{"type":"paragraph","position":{"start":{"line":7,"column":1},"end":{"line":7,"column":1}},"children":[{"type":"text","value":"Developers often require from common data structures and models to exchange data and aid interoperability between applications. Language-specific data models have many advantages in development environments where a common programming language is used and where large amounts of data handling require extensive validation. Standard schemas such as the JSON schema offer some basic validation, but more complex validation tasks often require language specific implementation. A language specific data model can perform common validation tasks that are needed by all applications in the development environment. For instance, we identified several challenges with using the CIM standard as the data model for applications in our development environment.","position":{"start":{"line":7,"column":1},"end":{"line":7,"column":1}},"key":"GEytrAnkFO"}],"key":"VuLHdkMj34"},{"type":"heading","depth":2,"position":{"start":{"line":9,"column":1},"end":{"line":9,"column":1}},"children":[{"type":"text","value":"Challenges in  CIM and Need for GDM","position":{"start":{"line":9,"column":1},"end":{"line":9,"column":1}},"key":"jPwfiUDd5G"}],"identifier":"challenges-in-cim-and-need-for-gdm","label":"Challenges in  CIM and Need for GDM","html_id":"challenges-in-cim-and-need-for-gdm","implicit":true,"key":"QpNX5ZiakY"},{"type":"list","ordered":false,"spread":false,"position":{"start":{"line":11,"column":1},"end":{"line":16,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":11,"column":1},"end":{"line":12,"column":1}},"children":[{"type":"paragraph","position":{"start":{"line":11,"column":1},"end":{"line":11,"column":1}},"children":[{"type":"inlineCode","value":"Lack of cross object validation: ","position":{"start":{"line":11,"column":1},"end":{"line":11,"column":1}},"key":"bYTgm7e4W0"},{"type":"text","value":" Validating CIM compatible power system data requires external script not tied to the data model. For example, on distribution networks, a three phase load should not be attached to a single phase line. Language-specific data models allow for validation of this type of model requirement during the construction of the model, and it ensures that all applications using the data model have a common model representation.","position":{"start":{"line":11,"column":1},"end":{"line":11,"column":1}},"key":"eCeN0MOApD"}],"key":"hblQzLy9jQ"}],"key":"ZRGfmeZFS7"},{"type":"listItem","spread":true,"position":{"start":{"line":13,"column":1},"end":{"line":14,"column":1}},"children":[{"type":"paragraph","position":{"start":{"line":13,"column":1},"end":{"line":13,"column":1}},"children":[{"type":"inlineCode","value":"Lack of unit conversion for power system quantities","position":{"start":{"line":13,"column":1},"end":{"line":13,"column":1}},"key":"xoqwf3CLMb"},{"type":"text","value":": Different applications use different unit representations, but unit conversion outside of the data model can introduce errors. Language specific data models can handle unit representation and avoid unit conversion errors.","position":{"start":{"line":13,"column":1},"end":{"line":13,"column":1}},"key":"e8BFCnK6Eu"}],"key":"gaODGYvseK"}],"key":"qro2EfUq5j"},{"type":"listItem","spread":true,"position":{"start":{"line":15,"column":1},"end":{"line":16,"column":1}},"children":[{"type":"paragraph","position":{"start":{"line":15,"column":1},"end":{"line":15,"column":1}},"children":[{"type":"inlineCode","value":"Complexity involved in creating language specific data models:","position":{"start":{"line":15,"column":1},"end":{"line":15,"column":1}},"key":"MHkXQvB111"},{"type":"text","value":" We have not identified robust methods for translating CIM into language specific data models. There are methods to autogenerate language specific data models from CIM, but these methods lack object type enforcement and the extensive validation capabilities needed for data intensive models.","position":{"start":{"line":15,"column":1},"end":{"line":15,"column":1}},"key":"IcvvQEAKj7"}],"key":"CGIQiz60vu"}],"key":"Gv56aamRx8"}],"key":"BKa9tyreCh"},{"type":"paragraph","position":{"start":{"line":17,"column":1},"end":{"line":17,"column":1}},"children":[{"type":"text","value":"In grid data models, we are attempting to solve these challenges. GDM is a collection of ","position":{"start":{"line":17,"column":1},"end":{"line":17,"column":1}},"key":"X2oUWg9ryR"},{"type":"link","url":"https://docs.pydantic.dev/latest/","position":{"start":{"line":17,"column":1},"end":{"line":17,"column":1}},"children":[{"type":"text","value":"pydantic","position":{"start":{"line":17,"column":1},"end":{"line":17,"column":1}},"key":"liOh6FhAW4"}],"urlSource":"https://docs.pydantic.dev/latest/","key":"q8CdmWbu8G"},{"type":"text","value":" data models (Pydantic is a third party package for defining data model along with validation logic) for representing power distribution assets.","position":{"start":{"line":17,"column":1},"end":{"line":17,"column":1}},"key":"JutP4Hlp9n"}],"key":"LOjhB69KZU"},{"type":"heading","depth":2,"position":{"start":{"line":19,"column":1},"end":{"line":19,"column":1}},"children":[{"type":"text","value":"Limitations of GDM","position":{"start":{"line":19,"column":1},"end":{"line":19,"column":1}},"key":"Ao0x7N5qK0"}],"identifier":"limitations-of-gdm","label":"Limitations of GDM","html_id":"limitations-of-gdm","implicit":true,"key":"emQJ9xTfkm"},{"type":"list","ordered":false,"spread":false,"position":{"start":{"line":21,"column":1},"end":{"line":23,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":21,"column":1},"end":{"line":22,"column":1}},"children":[{"type":"paragraph","position":{"start":{"line":21,"column":1},"end":{"line":21,"column":1}},"children":[{"type":"text","value":"GDM currently is only supported in ","position":{"start":{"line":21,"column":1},"end":{"line":21,"column":1}},"key":"BGQJ91iQwq"},{"type":"link","url":"https://python.org","position":{"start":{"line":21,"column":1},"end":{"line":21,"column":1}},"children":[{"type":"text","value":"Python","position":{"start":{"line":21,"column":1},"end":{"line":21,"column":1}},"key":"GUkfMjBV4j"}],"urlSource":"https://python.org","key":"ZckdrETqG7"},{"type":"text","value":" programming language.","position":{"start":{"line":21,"column":1},"end":{"line":21,"column":1}},"key":"y2yTwdinwI"}],"key":"fbbnpB20Z8"}],"key":"U2mf6Rs7R8"},{"type":"listItem","spread":true,"position":{"start":{"line":23,"column":1},"end":{"line":23,"column":1}},"children":[{"type":"paragraph","position":{"start":{"line":23,"column":1},"end":{"line":23,"column":1}},"children":[{"type":"text","value":"It is still in development phase and may not have representation for all the distribution assets you see in CIM.","position":{"start":{"line":23,"column":1},"end":{"line":23,"column":1}},"key":"yb2A9dlqzu"}],"key":"c3JNH7pbmk"}],"key":"uXtUdmg9gr"}],"key":"sYAyOk3mqP"}],"key":"BZYLOXzQnD"}],"key":"s0q696lLTF"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"Tracking Changes in GDM","url":"/dist-system/tracked-changes","group":"Advanced Usage"},"next":{"title":"Model Representation","url":"/cim/distribution-bus","group":"On CIM and GDM"}}},"domain":"http://localhost:3000"}